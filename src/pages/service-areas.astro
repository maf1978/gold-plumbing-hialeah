---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceAreas from '../components/sections/ServiceAreas.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import Container from '../components/ui/Container.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title={`Service Areas | ${siteConfig.businessName} | Miami-Dade`}
  description="Gold Plumbing serves Hialeah, Hialeah Gardens, Miami Lakes, Miami Gardens, and Doral. Local plumbers with upfront pricing."
  currentPath="/service-areas"
>
  <section class="py-16 bg-deep-blue text-white">
    <Container>
      <h1 class="text-4xl sm:text-5xl font-black uppercase tracking-tight mb-4">Service Areas</h1>
      <p class="text-white/80 text-lg max-w-2xl">Proudly serving Miami-Dade County with fast, bilingual plumbing service.</p>
    </Container>
  </section>
  <ServiceAreas />
  <FinalCTA leadSource="service-areas" />
</BaseLayout>
