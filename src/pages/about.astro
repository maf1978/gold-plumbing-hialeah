---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import Process from '../components/sections/Process.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title={`About Us | ${siteConfig.businessName}`}
  description="Gold Plumbing Hialeah — locally owned, licensed plumbers serving Hialeah and Miami-Dade. Bilingual service, upfront pricing, 24/7 emergencies."
  currentPath="/about"
  schemaExtras={{
    breadcrumbs: [
      { name: 'Home', url: `${siteConfig.siteUrl}/` },
      { name: 'About', url: `${siteConfig.siteUrl}/about` },
    ],
  }}
>
  <section class="py-16 lg:py-24 bg-deep-blue text-white">
    <Container narrow>
      <h1 class="text-4xl sm:text-5xl font-black uppercase tracking-tight mb-6">About {siteConfig.businessName}</h1>
      <p class="text-white/85 text-lg leading-relaxed mb-4">
        Gold Plumbing Hialeah is a locally owned plumbing company serving homeowners, condo associations, and commercial properties across Hialeah, Hialeah Gardens, Miami Lakes, Miami Gardens, and Doral.
      </p>
      <p class="text-white/75 leading-relaxed mb-4">
        We built this company on a simple promise: show up on time, explain the problem in plain language (English or Spanish), quote the price upfront, and fix it right the first time. No hourly surprises. No runaround.
      </p>
      <p class="text-white/75 leading-relaxed">
        Owner: {siteConfig.ownerName}. Licensed and insured. Available 24/7 for emergencies.
      </p>
    </Container>
  </section>
  <WhyUs />
  <Process />
  <FinalCTA leadSource="about" />
</BaseLayout>
