---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import { siteConfig } from '../../data/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`Servicios de Plomería Hialeah | ${siteConfig.businessName}`}
  description="Servicios completos de plomería en Hialeah: drenajes, calentadores, fugas, tuberías, accesorios y emergencias 24/7."
  locale="es"
  currentPath="/es/servicios"
>
  <section class="py-16 bg-deep-blue text-white">
    <Container>
      <h1 class="text-4xl font-black uppercase mb-4">Servicios de Plomería en Hialeah</h1>
      <p class="text-white/80 text-lg">Plomería residencial y comercial con precios claros y servicio bilingüe.</p>
    </Container>
  </section>
  <section class="py-16 bg-white">
    <Container>
      <div class="grid md:grid-cols-2 gap-8">
        {services.map((service) => (
          <article class="border border-gray-100 rounded-2xl p-8">
            <h2 class="text-2xl font-bold text-deep-blue mb-3">
              <a href={`/es/servicios/${service.data.slug}`}>{service.data.titleEs}</a>
            </h2>
            <p class="text-gray-600 mb-4">{service.data.introEs}</p>
            <a href={`/es/servicios/${service.data.slug}`} class="text-accent font-bold text-sm uppercase">Más Información →</a>
          </article>
        ))}
      </div>
    </Container>
  </section>
  <FinalCTA locale="es" leadSource="es-services" />
</BaseLayout>
