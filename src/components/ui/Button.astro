---
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'phone';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit';
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  type = 'button',
} = Astro.props;

const base =
  'inline-flex items-center justify-center font-bold uppercase tracking-wide rounded-full transition-all hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2';

const variants = {
  primary: 'bg-accent text-white shadow-lg shadow-accent/30',
  outline: 'border-2 border-accent text-accent bg-transparent hover:bg-accent hover:text-white',
  phone: 'bg-transparent text-white border border-white/30 hover:bg-white/10',
};

const sizes = {
  sm: 'px-4 py-2 text-xs',
  md: 'px-6 py-3 text-sm',
  lg: 'px-8 py-4 text-base',
};

const classes = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}
