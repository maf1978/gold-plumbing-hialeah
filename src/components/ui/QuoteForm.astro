---
import { siteConfig, ui, type Locale } from '../../data/site';

interface Props {
  locale?: Locale;
  variant?: 'full' | 'compact' | 'hero';
  leadSource?: string;
  id?: string;
}

const { locale = 'en', variant = 'full', leadSource = '', id = 'quote-form' } = Astro.props;
const t = ui[locale];
const prefix = locale === 'es' ? '/es' : '';
---

<form
  id={id}
  class:list={[
    'quote-form space-y-4',
    variant === 'hero' && 'bg-white/10 backdrop-blur-sm rounded-2xl p-5 border border-white/20',
    variant === 'full' && 'bg-white rounded-2xl p-6 sm:p-8 shadow-xl border border-gray-100',
    variant === 'compact' && 'bg-gray-50 rounded-xl p-5',
  ]}
  data-endpoint={siteConfig.quoteEndpoint}
  data-locale={locale}
>
  <input type="hidden" name="lead_source" value={leadSource} />

  <div class:list={[variant === 'hero' ? 'grid grid-cols-1 sm:grid-cols-2 gap-3' : 'grid grid-cols-1 sm:grid-cols-2 gap-4']}>
    <div>
      <label for={`${id}-name`} class:list={['block text-sm font-medium mb-1', variant === 'hero' ? 'text-white/90' : 'text-gray-700']}>
        {t.fullName} *
      </label>
      <input
        type="text"
        id={`${id}-name`}
        name="full_name"
        required
        autocomplete="name"
        class="w-full px-4 py-3 min-h-[48px] rounded-lg border border-gray-200 focus:ring-2 focus:ring-accent focus:border-accent text-gray-900 text-base sm:text-sm"
      />
    </div>
    <div>
      <label for={`${id}-phone`} class:list={['block text-sm font-medium mb-1', variant === 'hero' ? 'text-white/90' : 'text-gray-700']}>
        {t.phone} *
      </label>
      <input
        type="tel"
        id={`${id}-phone`}
        name="phone"
        required
        inputmode="tel"
        autocomplete="tel"
        class="w-full px-4 py-3 min-h-[48px] rounded-lg border border-gray-200 focus:ring-2 focus:ring-accent focus:border-accent text-gray-900 text-base sm:text-sm"
      />
    </div>
  </div>

  {variant !== 'hero' && (
    <>
      <div>
        <label for={`${id}-email`} class="block text-sm font-medium text-gray-700 mb-1">{t.email}</label>
        <input type="email" id={`${id}-email`} name="email" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:ring-2 focus:ring-accent focus:border-accent" />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for={`${id}-service`} class="block text-sm font-medium text-gray-700 mb-1">{t.serviceNeeded}</label>
          <select id={`${id}-service`} name="service" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:ring-2 focus:ring-accent focus:border-accent bg-white">
            <option value="">{t.selectService}</option>
            {siteConfig.services.map((s) => (
              <option value={s.slug}>{locale === 'es' ? s.titleEs : s.titleEn}</option>
            ))}
          </select>
        </div>
        <div>
          <span class="block text-sm font-medium text-gray-700 mb-2">{t.propertyType}</span>
          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 pt-1">
            <label class="flex items-center gap-2 cursor-pointer min-h-[44px]">
              <input type="radio" name="property_type" value="residential" checked class="text-accent w-5 h-5" />
              <span>{t.residential}</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer min-h-[44px]">
              <input type="radio" name="property_type" value="commercial" class="text-accent w-5 h-5" />
              <span>{t.commercial}</span>
            </label>
          </div>
        </div>
      </div>
      <div>
        <label for={`${id}-zip`} class="block text-sm font-medium text-gray-700 mb-1">{t.addressZip} *</label>
        <input type="text" id={`${id}-zip`} name="address_zip" required class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:ring-2 focus:ring-accent focus:border-accent" />
      </div>
      <div>
        <label for={`${id}-message`} class="block text-sm font-medium text-gray-700 mb-1">{t.message}</label>
        <textarea id={`${id}-message`} name="message" rows="3" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:ring-2 focus:ring-accent focus:border-accent resize-none"></textarea>
      </div>
    </>
  )}

  <button
    type="submit"
    class="w-full min-h-[48px] sm:w-auto px-8 py-4 bg-accent text-white font-bold uppercase tracking-wide rounded-full hover:opacity-90 active:scale-[0.98] transition shadow-lg shadow-accent/30"
  >
    {t.formSubmit}
  </button>

  <p class:list={['text-sm', variant === 'hero' ? 'text-white/70' : 'text-gray-500']} data-success-message style="display:none"></p>
  <p class:list={['text-xs', variant === 'hero' ? 'text-white/60' : 'text-gray-400']}>{t.formTrust}</p>
</form>

<script>
  document.querySelectorAll('.quote-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const el = e.currentTarget as HTMLFormElement;
      const endpoint = el.dataset.endpoint || 'QUOTE_ENDPOINT_PLACEHOLDER';
      const locale = el.dataset.locale || 'en';
      const successMsg =
        locale === 'es'
          ? '¡Gracias! Le llamaremos dentro de 1 hora hábil.'
          : "Thanks! We'll call you within 1 business hour.";

      const fd = new FormData(el);
      const payload = Object.fromEntries(fd.entries());

      try {
        if (endpoint !== 'QUOTE_ENDPOINT_PLACEHOLDER') {
          await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
        }
        const msg = el.querySelector('[data-success-message]') as HTMLElement;
        if (msg) {
          msg.textContent = successMsg;
          msg.style.display = 'block';
          msg.classList.add('text-green-600', 'font-medium');
        }
        el.reset();
      } catch {
        const msg = el.querySelector('[data-success-message]') as HTMLElement;
        if (msg) {
          msg.textContent =
            locale === 'es'
              ? 'Recibimos su solicitud. Le llamaremos pronto.'
              : 'We received your request. We will call you shortly.';
          msg.style.display = 'block';
        }
      }
    });
  });
</script>
