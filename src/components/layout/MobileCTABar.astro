---
import { siteConfig, ui, localePath, type Locale } from '../../data/site';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = ui[locale];
---

<div class="fixed bottom-0 left-0 right-0 z-50 lg:hidden bg-deep-blue border-t border-white/10 px-3 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] flex gap-2 sm:gap-3 shadow-2xl safe-bottom">
  <a
    href={`tel:${siteConfig.phoneRaw}`}
    class="flex-1 flex items-center justify-center gap-1.5 min-h-[48px] py-3 bg-white/10 text-white font-bold text-xs sm:text-sm uppercase rounded-full border border-white/20 active:scale-[0.98] transition"
  >
    <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
    <span class="truncate">{t.callNow}</span>
  </a>
  <a
    href={localePath('/free-quote', locale)}
    class="flex-1 flex items-center justify-center min-h-[48px] py-3 bg-accent text-white font-bold text-xs sm:text-sm uppercase rounded-full shadow-lg active:scale-[0.98] transition"
  >
    <span class="truncate px-1">{t.bookPlumber}</span>
  </a>
</div>
