---
import { siteConfig, ui, localePath, type Locale } from '../../data/site';
import { getNavLinks } from '../../data/nav';

interface Props {
  locale?: Locale;
  transparent?: boolean;
  currentPath?: string;
}

const { locale = 'en', transparent = false, currentPath = '/' } = Astro.props;
const t = ui[locale];
const navLinks = getNavLinks(locale);
const altLocale = locale === 'en' ? 'es' : 'en';
const altPath = locale === 'en' ? `/es${currentPath === '/' ? '/' : currentPath}` : currentPath.replace('/es', '') || '/';
---

<header
  class:list={[
    'sticky top-0 z-50 transition-colors safe-bottom',
    transparent ? 'bg-deep-blue/95 backdrop-blur-md border-b border-white/10' : 'bg-deep-blue border-b border-white/10 shadow-lg',
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 sm:h-16 lg:h-20">
      <a href={locale === 'es' ? '/es/' : '/'} class="flex items-center gap-2 sm:gap-3 shrink-0 min-h-[44px]">
        <div class="w-9 h-9 sm:w-10 sm:h-10 lg:w-12 lg:h-12 rounded-lg bg-gold/20 border border-gold/40 flex items-center justify-center">
          <span class="text-gold font-black text-base sm:text-lg lg:text-xl tracking-tighter">GP</span>
        </div>
        <div class="hidden min-[400px]:block leading-tight">
          <span class="block text-gold font-bold text-xs sm:text-sm lg:text-base tracking-wide">Gold Plumbing</span>
          <span class="block text-white/80 text-[10px] sm:text-xs font-medium">Hialeah</span>
        </div>
      </a>

      <nav class="hidden lg:flex items-center gap-6 xl:gap-8" aria-label="Main navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'text-sm font-semibold uppercase tracking-wide transition-colors min-h-[44px] flex items-center',
              (currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href.replace('/#', '/'))))
                ? 'text-gold'
                : 'text-white/90 hover:text-gold',
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2 sm:gap-3 lg:gap-4">
        <a
          href={`tel:${siteConfig.phoneRaw}`}
          class="hidden md:flex items-center gap-2 text-white font-semibold text-sm hover:text-accent transition min-h-[44px]"
          aria-label={`Call ${siteConfig.phone}`}
        >
          <svg class="w-5 h-5 text-accent shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
          </svg>
          <span class="hidden lg:inline">{siteConfig.phone}</span>
        </a>

        <a
          href={localePath('/free-quote', locale)}
          class="inline-flex items-center justify-center min-h-[40px] sm:min-h-[44px] px-3 sm:px-5 py-2 sm:py-2.5 bg-accent text-white text-[10px] sm:text-xs font-bold uppercase tracking-wider rounded-full hover:opacity-90 active:scale-[0.98] transition shadow-lg shadow-accent/30"
        >
          {t.bookNow}
        </a>

        <a
          href={altPath}
          class="inline-flex items-center justify-center min-h-[40px] min-w-[40px] text-xs font-semibold text-white/70 hover:text-gold uppercase border border-white/20 px-2 rounded"
          hreflang={altLocale}
        >
          {altLocale === 'es' ? 'ES' : 'EN'}
        </a>

        <button
          id="mobile-menu-toggle"
          type="button"
          class="lg:hidden inline-flex items-center justify-center min-h-[44px] min-w-[44px] p-2 text-white -mr-1"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden border-t border-white/10 py-3 space-y-0.5 pb-4" role="navigation" aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="mobile-nav-link block py-3 px-1 text-white font-medium hover:text-gold transition min-h-[44px] flex items-center">{link.label}</a>
      ))}
      <a href={`tel:${siteConfig.phoneRaw}`} class="mobile-nav-link block py-3 px-1 text-accent font-bold min-h-[44px] flex items-center">{siteConfig.phone}</a>
      <a href={localePath('/free-quote', locale)} class="mobile-nav-link block py-3.5 mt-2 text-center bg-accent text-white font-bold rounded-full uppercase text-sm min-h-[48px] flex items-center justify-center">
        {t.bookNow}
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open menu');
    });
  });
</script>
