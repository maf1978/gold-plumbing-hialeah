---
import { siteConfig, ui, localePath, type Locale } from '../../data/site';
import Container from '../ui/Container.astro';
import QuoteForm from '../ui/QuoteForm.astro';

interface Props {
  locale?: Locale;
  leadSource?: string;
}

const { locale = 'en', leadSource = 'final-cta' } = Astro.props;
const t = ui[locale];
---

<section class="py-16 lg:py-24 bg-accent">
  <Container>
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="text-white">
        <h2 class="text-3xl sm:text-4xl font-black uppercase mb-4">{t.readyToFix}</h2>
        <p class="text-white/90 text-lg mb-6">
          {locale === 'es'
            ? 'Llame ahora o reserve en línea. Respondemos en 1 hora hábil con precios claros.'
            : 'Call now or book online. We respond within 1 business hour with upfront pricing.'}
        </p>
        <a href={`tel:${siteConfig.phoneRaw}`} class="inline-flex items-center gap-3 text-xl sm:text-2xl font-black hover:underline break-all sm:break-normal">
          {siteConfig.phone}
        </a>
        <p class="text-white/70 text-sm mt-4">{t.formTrust}</p>
      </div>
      <QuoteForm locale={locale} variant="full" leadSource={leadSource} id="final-cta-form" />
    </div>
  </Container>
</section>
