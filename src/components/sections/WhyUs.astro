---
import { siteConfig, ui, type Locale } from '../../data/site';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = ui[locale];
---

<section class="py-16 lg:py-24 bg-deep-blue text-white">
  <Container>
    <SectionHeading title={t.whyChooseUs} light />
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
      {siteConfig.differentiators.map((diff, i) => {
        const d = locale === 'es' ? diff.es : diff.en;
        return (
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition">
            <div class="w-10 h-10 rounded-full bg-accent/20 text-accent font-black flex items-center justify-center mb-4 text-lg">
              {i + 1}
            </div>
            <h3 class="font-bold text-lg mb-2">{d.title}</h3>
            <p class="text-white/70 text-sm leading-relaxed">{d.description}</p>
          </div>
        );
      })}
    </div>
  </Container>
</section>
