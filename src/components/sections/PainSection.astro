---
import { ui, type Locale } from '../../data/site';
import Container from '../ui/Container.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = ui[locale];
---

<section class="py-16 lg:py-20 bg-white">
  <Container narrow>
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-black uppercase text-deep-blue mb-6">{t.painHeadline}</h2>
      <p class="text-gray-600 text-lg leading-relaxed">{t.painBody}</p>
    </div>
  </Container>
</section>
