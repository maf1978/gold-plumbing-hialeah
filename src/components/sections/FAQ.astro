---
import { ui, type Locale } from '../../data/site';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface FAQ {
  question: string;
  questionEs?: string;
  answer: string;
  answerEs?: string;
}

interface Props {
  locale?: Locale;
  faqs: FAQ[];
  title?: string;
}

const { locale = 'en', faqs, title } = Astro.props;
const t = ui[locale];
---

<section class="py-16 lg:py-20 bg-gray-50">
  <Container narrow>
    <SectionHeading title={title || t.faq} />
    <div class="mt-10 space-y-4">
      {faqs.map((faq) => (
        <details class="group bg-white rounded-xl border border-gray-100 overflow-hidden">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-4 font-bold text-deep-blue hover:text-accent transition list-none">
            <h3 class="text-base pr-4">{locale === 'es' && faq.questionEs ? faq.questionEs : faq.question}</h3>
            <span class="text-accent text-xl shrink-0 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <div class="px-6 pb-5 text-gray-600 leading-relaxed text-sm">
            <p>{locale === 'es' && faq.answerEs ? faq.answerEs : faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </Container>
</section>
